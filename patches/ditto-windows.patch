+import os
+import subprocess
+import time
+import numpy as np
+import imageio_ffmpeg
+import shutil
+
+
+def _find_ffmpeg():
+    return imageio_ffmpeg.get_ffmpeg_exe()
+
+
+class VideoAudioWriter:
+    """Streams raw video frames + raw audio samples into a single ffmpeg process,
+    producing an interleaved audio+video fMP4 (fragmented)."""
+
+    def __init__(self, video_path, audio_path, fps=25, **kwargs):
+        self.codec = kwargs.get("vcodec", "libx264")
+        self.crf = kwargs.get("crf", 18)
+        self.gop = kwargs.get("gop", 25)
+        self.movflags = kwargs.get("movflags", "")
+        self.audio_offset = float(kwargs.get("audio_offset", 0.8))
+        self.fps = fps
+        self.video_path = video_path
+        self.audio_path = audio_path
+        self.proc = None
+        os.makedirs(os.path.dirname(video_path), exist_ok=True)
+        open(audio_path, "wb").close()
+
+    def _start(self, w, h):
+        cmd = [
+            _find_ffmpeg(), "-y",
+            "-f", "rawvideo", "-pix_fmt", "rgb24", "-s", f"{w}x{h}", "-r", str(self.fps), "-i", "-",
+            "-itsoffset", str(self.audio_offset), "-f", "f32le", "-ar", "16000", "-ac", "1", "-i", self.audio_path,
+            "-map", "0:v", "-map", "1:a",
+            "-c:v", self.codec, "-pix_fmt", "yuv420p", "-crf", str(self.crf), "-g", str(self.gop),
+            "-tune", "zerolatency", "-bf", "0",
+            "-c:a", "aac", "-b:a", "128k",
+            "-fflags", "+flush_packets",
+            "-avioflags", "direct",
+            "-flush_packets", "1",
+            "-max_muxing_queue_size", "4096",
+        ]
+        if self.movflags:
+            cmd += ["-movflags", self.movflags]
+        cmd += [self.video_path]
+        print(f"{time.strftime('%H:%M:%S')}.{int(time.time() * 1000) % 1000:03d} [writer] ffmpeg cmd: {' '.join(cmd)}", flush=True)
+        self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL)
+
+    def __call__(self, img, fmt="bgr"):
+        if fmt == "bgr":
+            frame = img[..., ::-1]
+        else:
+            frame = img
+        if self.proc is None:
+            h, w = frame.shape[:2]
+            self._start(w, h)
+        self.proc.stdin.write(frame.tobytes())
+
+    def write_audio(self, samples):
+        data = np.ascontiguousarray(samples, dtype=np.float32).tobytes()
+        with open(self.audio_path, "ab") as f:
+            f.write(data)
+
+    def close(self):
+        if self.proc is not None:
+            try:
+                self.proc.stdin.close()
+            except Exception:
+                pass
+            self.proc.wait()
